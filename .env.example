# Copiar a .env y completar las claves en privado (no subir a GitHub).
# Todas las contraseñas deben ser únicas; las de las bases contienen solo letras y números.
DB_ROOT_PASSWORD=
DB_PASSWORD=
AUTH_DB_PASSWORD=
CATALOG_DB_PASSWORD=
ORDERS_DB_PASSWORD=
CLASSES_DB_PASSWORD=
SERVICE_KEY=
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=

# Asistente de ayuda (Claude). Crea la clave en console.anthropic.com y pégala aquí.
ANTHROPIC_API_KEY=
ASISTENTE_MODELO=claude-haiku-5-5

# Imágenes y videos en Amazon S3 (vacío = se guardan en disco).
# En AWS no pongas claves: la EC2 usa el rol LabInstanceProfile.
S3_BUCKET=
AWS_REGION=us-east-1
# Opcional: https://xxxx.cloudfront.net si sirves los medios por CloudFront.
MEDIA_BASE_URL=
# JWT para la app móvil. Genera uno con: openssl rand -hex 32
JWT_SECRET=
JWT_MINUTOS=15
REFRESH_DIAS=7
# true en AWS con HTTPS (CloudFront)
COOKIE_SECURE=false
# 1 en AWS con CloudFront: así el límite de intentos usa la IP real del visitante
PROXIES_CONFIABLES=0
# Swagger UI en /swagger-ui.html (false para apagarlo)
SWAGGER_ENABLED=true
