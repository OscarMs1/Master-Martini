{
  "name": "master-martini-fullstack2-ep2",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "api": "node server/api.mjs",
    "test:node": "node --test testing/commerce.test.mjs",
    "test:assets": "node --test testing/assets.test.mjs",
    "test:node:coverage": "node --experimental-test-coverage --test testing/commerce.test.mjs",
    "check:logic": "node testing/smoke-node.mjs",
    "check:syntax": "node testing/check-js-syntax.cjs",
    "validate:frontend": "npm run check:syntax && npm run build && npm run test:coverage",
    "test:api": "node testing/api.integration.mjs",
    "test:e2e": "node testing/browser.e2e.mjs",
    "test:e2e:api": "node testing/backend.browser.e2e.mjs",
    "validate:all": "npm run check:syntax && npm run check:logic && npm run test:node && npm run test:assets && npm run test:api && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@^4.64.12",
    "esbuild": "npm:esbuild-wasm@^0.28.2"
  }
}
